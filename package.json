{
  "name": "table-companion-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4271 --strictPort",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test:domain": "vitest run --project domain",
    "test:component": "vitest run --project component",
    "test:journey": "playwright test",
    "verify": "node scripts/verify.mjs",
    "dev:worker": "wrangler dev --port 8791",
    "test:room": "playwright test -c playwright.room.config.ts",
    "content": "npx tsx scripts/compile-content.ts ../table-companion/public/content content-dist",
    "serve:content": "node scripts/serve-content.mjs",
    "publish:content": "node scripts/publish-content.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.11",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
